{
  "name": "@musetric/monorepo",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.17.1",
  "engines": {
    "node": "26.2.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "yarn workspaces foreach --all --parallel --interlaced run dev",
    "build:project": "yarn workspaces foreach --all --topological-dev --parallel --interlaced run build:project",
    "dev:desktop": "yarn build:project && yarn workspace @musetric/app dev:desktop",
    "build:desktop": "yarn build:project && yarn workspace @musetric/app build:desktop",
    "dev:mobile": "yarn workspace @musetric/app dev:mobile",
    "build:mobile": "yarn workspace @musetric/app build:mobile",
    "dev:android": "yarn workspace @musetric/app dev:android",
    "build:android": "yarn workspace @musetric/app build:android",
    "dev:ios": "yarn workspace @musetric/app dev:ios",
    "build:ios": "yarn workspace @musetric/app build:ios",
    "dev:app": "yarn workspace @musetric/app dev:app",
    "build:app": "yarn workspace @musetric/app build:app",
    "project:init": "yarn workspaces foreach --all --parallel --interlaced run project:init",
    "project:start": "yarn workspaces foreach --all --parallel --interlaced run project:start",
    "check:deps:security": "yarn npm audit --all --recursive --severity high",
    "check:deps:dupe": "yarn constraints && yarn dedupe --check",
    "fix:deps:dupe": "yarn constraints --fix && yarn && yarn dedupe",
    "check:unused": "knip",
    "check:format": "prettier --check .",
    "fix:format": "prettier . --write --list-different",
    "check:translations": "yarn workspaces foreach --all --parallel --interlaced run check:translations",
    "fix:translations": "yarn workspaces foreach --all --parallel --interlaced run fix:translations",
    "check:openapi": "yarn workspaces foreach --all --parallel --interlaced run check:openapi",
    "fix:openapi": "yarn workspaces foreach --all --parallel --interlaced run fix:openapi",
    "check:ts": "yarn workspaces foreach --all --parallel --interlaced run check:ts",
    "check:lint": "yarn workspaces foreach --all --parallel --interlaced run check:lint",
    "fix:lint": "yarn workspaces foreach --all --parallel --interlaced run fix:lint",
    "check:rust": "yarn workspaces foreach --all --parallel --interlaced run check:rust",
    "fix:rust": "yarn workspaces foreach --all --parallel --interlaced run fix:rust",
    "test": "yarn workspaces foreach --all --parallel --interlaced run test"
  },
  "devDependencies": {
    "knip": "catalog:",
    "prettier": "catalog:"
  },
  "resolutions": {
    "@electron/asar": "4.2.1",
    "@electron/universal": "3.0.6",
    "adm-zip": "0.6.0",
    "browserslist": "4.28.8",
    "filelist": "2.0.2",
    "onnxruntime-web": "1.29.0",
    "sharp": "0.35.3",
    "tar": "7.5.21"
  }
}

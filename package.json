{
  "name": "@musetric/monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "pnpm -r --parallel --no-bail run dev",
    "build:project": "pnpm -r run build:project",
    "pack:installer": "pnpm build:project && pnpm --filter @musetric/app pack:installer",
    "dev:android": "pnpm --filter @musetric/app dev:android",
    "build:android": "pnpm --filter @musetric/app build:android",
    "dev:ios": "pnpm --filter @musetric/app dev:ios",
    "build:ios": "pnpm --filter @musetric/app build:ios",
    "dev:app": "pnpm --filter @musetric/app dev:app",
    "build:app": "pnpm --filter @musetric/app build:app",
    "project:init": "pnpm -r --parallel --if-present run project:init",
    "project:start": "pnpm -r --parallel --if-present run project:start",
    "check:deps:security": "pnpm audit --audit-level high",
    "check:deps:security:rust": "osv-scanner scan source --lockfile packages/server/Cargo.lock",
    "check:deps:dupe": "node packages/checks/scripts/checkDeps.ts && pnpm dedupe --check",
    "fix:deps:dupe": "pnpm install && pnpm dedupe",
    "check:dupe": "jscpd packages --config .jscpd.json",
    "check:editorconfig": "editorconfig-checker",
    "check:english": "node packages/checks/src/cli.ts english",
    "check:notices": "node packages/checks/src/cli.ts notices",
    "check:links": "node packages/checks/src/cli.ts links",
    "check:comments": "node packages/checks/src/cli.ts comments",
    "check:unused": "knip",
    "check:format": "prettier --check .",
    "fix:format": "prettier . --write --list-different",
    "check:translations": "pnpm -r run check:translations",
    "fix:translations": "pnpm -r run fix:translations",
    "check:ts": "pnpm -r run check:ts",
    "check:lint": "pnpm -r run check:lint",
    "fix:lint": "pnpm -r run fix:lint",
    "check:rust": "pnpm -r run check:rust",
    "fix:rust": "pnpm -r run fix:rust",
    "test": "pnpm -r run test"
  },
  "devDependencies": {
    "knip": "catalog:",
    "prettier": "catalog:"
  },
  "checks": {
    "english": {
      "except": [
        "packages/ai/src/transcription/hallucinationFilter.ts",
        "packages/ai/src/transcription/__test__/filters.test.ts",
        "packages/ai/src/transcription/__test__/wordPieces.test.ts",
        "packages/server/src/cached_file.rs"
      ]
    }
  }
}

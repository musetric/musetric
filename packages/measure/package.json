{
  "name": "@musetric/measure",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "check:ts": "tsc --build",
    "check:lint": "eslint . --cache --cache-strategy content",
    "fix:lint": "eslint . --fix --cache --cache-strategy content",
    "measure:timing": "pnpm --filter @musetric/dsp build:app && node ./scripts/measure.ts timing",
    "measure:delay": "pnpm --filter @musetric/dsp build:app && node ./scripts/measure.ts delay",
    "measure:sound": "pnpm --filter @musetric/dsp build:app && node ./scripts/measure.ts sound",
    "measure:cursor": "pnpm --filter @musetric/dsp build:app && node ./scripts/measure.ts cursor",
    "measure:failure": "pnpm --filter @musetric/dsp build:app && node ./scripts/measure.ts failure",
    "measure:seek": "pnpm --filter @musetric/dsp build:app && node ./scripts/measure.ts seek"
  },
  "devDependencies": {
    "@musetric/api": "workspace:*",
    "@musetric/audio": "workspace:*",
    "@musetric/engine": "workspace:*",
    "@musetric/dsp": "workspace:*",
    "@musetric/eslint-config": "workspace:*",
    "@musetric/fft": "workspace:*",
    "@musetric/spectrogram": "workspace:*",
    "@musetric/utils": "workspace:*",
    "@tauri-apps/api": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "@webgpu/types": "catalog:",
    "axios": "catalog:",
    "eslint": "catalog:",
    "immer": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:",
    "zustand": "catalog:"
  }
}

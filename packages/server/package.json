{
  "name": "@musetric/server",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "exports": {
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "yarn build:browser && cargo run --quiet --locked -- --listen 0.0.0.0:3000 --tls-self-signed --database storage/db/app.db --blobs storage/blobs --models storage/models --browser-bundle dist-browser --public storage/public",
    "build:browser": "vite build --configLoader native",
    "check:ts": "tsc --build",
    "check:lint": "eslint . --cache --cache-strategy content",
    "fix:lint": "eslint . --fix --cache --cache-strategy content",
    "check:rust:ast": "ast-grep scan . ../app/src-tauri",
    "check:rust:fmt": "cargo fmt --all --check",
    "check:rust:clippy": "cargo clippy --workspace --all-targets --locked -- -D warnings",
    "check:rust:test": "cargo test --workspace --locked",
    "check:rust": "yarn check:rust:ast && yarn check:rust:fmt && yarn check:rust:clippy && yarn check:rust:test",
    "fix:rust": "cargo fmt --all && cargo clippy --workspace --all-targets --fix --allow-dirty --allow-staged",
    "test": "vitest run"
  },
  "devDependencies": {
    "@ast-grep/cli": "catalog:",
    "@musetric/ai": "workspace:*",
    "@musetric/cqt": "workspace:*",
    "@musetric/eslint-config": "workspace:*",
    "@musetric/fft": "workspace:*",
    "@musetric/utils": "workspace:*",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "eslint": "catalog:",
    "onnxruntime-web": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}

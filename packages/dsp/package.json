{
  "name": "@musetric/dsp",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist/dsp.js",
    "dist/dsp.d.ts",
    "dist/dsp_bg.wasm",
    "dist/dsp_bg.wasm.d.ts"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/musetric/musetric.git",
    "directory": "packages/dsp"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/dsp.d.ts",
      "import": "./dist/dsp.js",
      "default": "./dist/dsp.js"
    },
    "./dsp.wasm": "./dist/dsp_bg.wasm"
  },
  "scripts": {
    "build:project": "node scripts/buildWasm.ts",
    "dev": "node scripts/buildWasm.ts",
    "check:ts": "tsc --build",
    "check:lint": "eslint . --cache --cache-strategy content",
    "fix:lint": "eslint . --fix --cache --cache-strategy content"
  },
  "devDependencies": {
    "@musetric/eslint-config": "workspace:*",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:"
  }
}

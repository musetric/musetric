{
  "name": "@musetric/ai",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    "./vite": {
      "monorepo": "./src/browserBundle.vite.ts",
      "default": "./src/browserBundle.vite.ts"
    }
  },
  "scripts": {
    "build:project": "tsc --build",
    "check:ts": "tsc --build",
    "check:lint": "eslint . --cache --cache-strategy content",
    "fix:lint": "eslint . --fix --cache --cache-strategy content",
    "check:models": "node scripts/checkModelPins.ts",
    "test": "vitest run",
    "measure:parity": "node ./scripts/measureParity.ts"
  },
  "peerDependencies": {
    "@huggingface/transformers": "catalog:",
    "@musetric/cqt": "workspace:*",
    "@musetric/fft": "workspace:*",
    "@musetric/spectrogram": "workspace:*",
    "@musetric/utils": "workspace:*",
    "onnxruntime-web": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@huggingface/transformers": "catalog:",
    "@musetric/cqt": "workspace:*",
    "@musetric/eslint-config": "workspace:*",
    "@musetric/fft": "workspace:*",
    "@musetric/spectrogram": "workspace:*",
    "@musetric/utils": "workspace:*",
    "@types/node": "catalog:",
    "@types/ws": "catalog:",
    "@typescript/native": "catalog:",
    "@webgpu/types": "catalog:",
    "eslint": "catalog:",
    "onnxruntime-web": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "ws": "catalog:",
    "zod": "catalog:"
  }
}

{
  "name": "@musetric/ai",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist/library/**",
    "dist/**/*.d.ts"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/musetric/musetric.git",
    "directory": "packages/ai"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./package.json": "./package.json",
    "./separation": {
      "monorepo": "./src/separation/index.ts",
      "types": "./dist/separation/index.d.ts",
      "import": "./dist/library/separation.js",
      "default": "./dist/library/separation.js"
    },
    "./vite": {
      "monorepo": "./src/browserBundle.vite.ts",
      "default": "./src/browserBundle.vite.ts"
    }
  },
  "scripts": {
    "build:project": "tsc --build && vite build --config vite.library.config.ts",
    "check:ts": "tsc --build",
    "check:lint": "eslint . --cache --cache-strategy content",
    "fix:lint": "eslint . --fix --cache --cache-strategy content",
    "check:models": "node scripts/checkModelPins.ts",
    "test": "vitest run",
    "measure:parity": "node ./scripts/measureParity.ts"
  },
  "peerDependencies": {
    "@huggingface/transformers": "catalog:",
    "onnxruntime-web": "catalog:"
  },
  "devDependencies": {
    "@huggingface/transformers": "catalog:",
    "@musetric/cqt": "workspace:*",
    "@musetric/eslint-config": "workspace:*",
    "@musetric/fft": "workspace:*",
    "@musetric/spectrogram": "workspace:*",
    "@musetric/utils": "workspace:*",
    "@types/node": "catalog:",
    "@types/ws": "catalog:",
    "@typescript/native": "catalog:",
    "@webgpu/types": "catalog:",
    "eslint": "catalog:",
    "onnxruntime-web": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "ws": "catalog:",
    "zod": "catalog:"
  }
}

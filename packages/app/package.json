{
  "name": "@musetric/app",
  "productName": "Musetric",
  "version": "0.1.0",
  "description": "Musetric — audio separation, transcription and analysis app",
  "author": "Musetric <musetric@gmail.com>",
  "license": "MIT",
  "repository": "github:musetric/musetric",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:ui": "vite --configLoader native",
    "build:ui": "pnpm build:icons && vite build --configLoader native && pnpm build:executor",
    "pack:installer": "node ./scripts/packInstaller.ts",
    "pack:msix": "node ./scripts/packMsix.ts",
    "dev:app": "tauri dev",
    "build:app": "tauri build --no-bundle",
    "build:icons": "node ./scripts/buildIcons.ts",
    "init:android": "node ./scripts/initNative.ts android",
    "init:ios": "node ./scripts/initNative.ts ios",
    "dev:android": "pnpm init:android && tauri android dev",
    "build:android": "pnpm init:android && tauri android build --apk",
    "dev:ios": "pnpm init:ios && tauri ios dev --config src-tauri/gen/apple/identity.conf.json",
    "build:ios": "pnpm init:ios && tauri ios build --config src-tauri/gen/apple/identity.conf.json",
    "check:ts": "tsc --build",
    "check:lint": "eslint . --cache --cache-strategy content",
    "fix:lint": "eslint . --fix --cache --cache-strategy content",
    "build:executor": "vite build --config vite.executor.config.ts --configLoader native"
  },
  "devDependencies": {
    "@musetric/eslint-config": "workspace:*",
    "@musetric/script": "workspace:*",
    "@resvg/resvg-js": "catalog:",
    "@tauri-apps/cli": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "dependencies": {
    "@musetric/ai": "workspace:*",
    "@musetric/cqt": "workspace:*",
    "@musetric/fft": "workspace:*",
    "@musetric/spectrogram": "workspace:*",
    "@musetric/utils": "workspace:*",
    "onnxruntime-web": "catalog:",
    "zod": "catalog:"
  }
}

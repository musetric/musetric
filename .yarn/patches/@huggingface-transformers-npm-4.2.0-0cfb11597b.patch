         });
-    const session = await (apis.IS_WEB_ENV ? (webInitChain = webInitChain.then(load)) : load());
+    // A failed WebGPU session must not poison all later session creations. A caller can
+    // deliberately retry a model with the WASM provider after a driver or validation
+    // failure, so recover the *previous* chain while preserving the failure for the
+    // session that originally caused it.
+    const session = await (apis.IS_WEB_ENV
+        ? (webInitChain = webInitChain.catch(() => undefined).then(load))
+        : load());
     session.config = session_config;
     return session;
 }
@@ -318,4 +324,7 @@ export async function runInferenceSession(session, ortFeed) {
 export async function runInferenceSession(session, ortFeed) {
     const run = () => session.run(ortFeed);
-    return apis.IS_WEB_ENV ? (webInferenceChain = webInferenceChain.then(run)) : run();
+    // A WebGPU inference failure must not prevent a later WASM fallback run.
+    return apis.IS_WEB_ENV
+        ? (webInferenceChain = webInferenceChain.catch(() => undefined).then(run))
+        : run();
 }
